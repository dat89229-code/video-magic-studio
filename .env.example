# VietQR recipient account — do not commit your real .env file.
PAYMENT_BANK_CODE=MB
PAYMENT_ACCOUNT_NUMBER=YOUR_ACCOUNT_NUMBER
PAYMENT_ACCOUNT_NAME=YOUR_ACCOUNT_HOLDER_NAME

# A long random secret. Configure the same value in SePay's webhook authentication.
SEPAY_WEBHOOK_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Add the deployed frontend URL before accepting public browser traffic.
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
