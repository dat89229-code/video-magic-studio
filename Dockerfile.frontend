FROM oven/bun:1.3

WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
ARG VITE_APP_SURFACE
ENV VITE_APP_SURFACE=$VITE_APP_SURFACE
ARG VITE_SUPPORT_API_URL
ENV VITE_SUPPORT_API_URL=$VITE_SUPPORT_API_URL
RUN bun run build

EXPOSE 10000
CMD ["sh", "-c", "bun server/frontend_server.mjs"]
